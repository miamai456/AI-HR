{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(aihr_http_requests_total[5m]))", "refId": "A"}],
      "title": "API request rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(aihr_http_request_duration_seconds_bucket[5m])))", "refId": "A"}],
      "title": "API P95 latency",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "sum(rate(aihr_analysis_context_requests_total{cached=\"true\"}[15m])) / clamp_min(sum(rate(aihr_analysis_context_requests_total[15m])), 0.001)", "refId": "A"}],
      "title": "Context cache hit rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (outcome, mode) (rate(aihr_assistant_requests_total[5m]))", "legendFormat": "{{mode}} {{outcome}}", "refId": "A"}],
      "title": "Assistant request outcomes",
      "type": "timeseries"
    }
  ],
