AIHR_ASSISTANT_PROVIDER=deepseek
AIHR_RUNTIME_IMAGE=localhost:5000/aihr-runtime:0.1.4
AIHR_PYTHON_BASE_IMAGE=quay.io/fedora/python-312:latest
AIHR_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
AIHR_REGISTRY=localhost:5000
AIHR_RUNTIME_VERSION=0.1.4
AIHR_SEED_DEMO_DATA=false
AIHR_SYNTHETIC_SEED_RECOMMENDATIONS=10000
AIHR_SYNTHETIC_SEED_CANDIDATES=8000
AIHR_SYNTHETIC_SEED_JOBS=300
AIHR_POSTGRES_HOST_PORT=5432
AIHR_API_HOST_PORT=8000
AIHR_TEMPO_HOST_PORT=3200
AIHR_PROMETHEUS_HOST_PORT=9090
AIHR_GRAFANA_HOST_PORT=3000
AIHR_DASHBOARD_HOST_PORT=8501
AIHR_FRONTEND_HOST_PORT=5173
AIHR_MONGO_HOST_PORT=27017
AIHR_ASSISTANT_BASE_URL=https://api.deepseek.com
AIHR_ASSISTANT_MODEL=deepseek-chat
AIHR_ASSISTANT_API_KEY=replace-with-your-deepseek-api-key
AIHR_ASSISTANT_API_KEY_FILE=/run/secrets/deepseek_api_key
AIHR_ASSISTANT_CACHE_TTL_SECONDS=300
AIHR_CACHE_URL=redis://cache:6379/0
AIHR_ANALYSIS_CONTEXT_CACHE_TTL_SECONDS=300
AIHR_ANALYSIS_PREWARM=true
AIHR_ANALYSIS_QUEUE_ENABLED=true
AIHR_ANALYSIS_QUEUE_NAME=aihr
AIHR_POSTGRES_DATABASE=aihr
AIHR_POSTGRES_USER=aihr
AIHR_POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
AIHR_MONGO_URL=mongodb://mongo:27017
AIHR_MONGO_DATABASE=aihr_documents
AIHR_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
AIHR_OPERATIONS_TOKEN_FILE=/run/secrets/operations_token
AIHR_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318
AIHR_OTEL_SERVICE_NAME=aihr-api
