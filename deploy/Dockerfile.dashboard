ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/aihr:/opt/aihr/src

USER root
WORKDIR /opt/aihr
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .
COPY config ./config
COPY app ./app
RUN useradd --create-home --uid 10001 aihr
USER 10001

EXPOSE 8501
CMD ["sh", "-c", "exec streamlit run app/Home.py --server.address=0.0.0.0 --server.port ${PORT:-8501} --server.headless=true"]
