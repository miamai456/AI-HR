ARG RUNTIME_IMAGE=aihr-runtime:local
FROM ${RUNTIME_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/aihr/src

USER root
WORKDIR /opt/aihr
COPY src ./src
COPY config ./config
COPY migrations ./migrations

EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn aihr.api.main:app --host 0.0.0.0 --port 8000"]

